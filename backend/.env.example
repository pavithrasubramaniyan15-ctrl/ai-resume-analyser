# ResumeIQ AI — Backend Environment Variables
# Copy to .env and fill in your values

# HuggingFace API Key (for LLM inference)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Optional: Redis for caching (defaults to in-memory)
REDIS_URL=redis://localhost:6379

# Optional: Database (defaults to in-memory dict)
DATABASE_URL=postgresql://user:pass@localhost:5432/resumeiq

# Server config
HOST=0.0.0.0
PORT=8000
ENV=development
